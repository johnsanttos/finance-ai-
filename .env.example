# Banco de dados (SQLite local por padrão; para PostgreSQL, altere o provider no schema.prisma e a URL abaixo)
DATABASE_URL="file:./dev.db"

# Inteligência Artificial Multimodal (Configure ao menos uma das chaves abaixo)
# Obtenha sua chave Gemini em: https://aistudio.google.com/apikey
GEMINI_API_KEY="sua_chave_gemini_aqui"
GEMINI_MODEL="gemini-2.5-flash"

# Opcional: Provedor alternativo OpenAI (caso prefira usar GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Segurança / Autenticação opcional caso exposto na internet
APP_ACCESS_PIN=""
